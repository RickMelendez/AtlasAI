# ── Atlas AI Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────

# Shared-secret key required on every HTTP route and the WebSocket handshake.
# Leave blank for local dev (unauthenticated). MUST be set for any public
# deployment (Railway, etc.) — otherwise anyone with the URL can burn your
# Anthropic + TTS credits. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATLAS_API_KEY=

# ── Optional: Text-to-Speech ──────────────────────────────────────────────────

# ElevenLabs (best quality voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=                 # leave blank for default Rachel voice

# Fish Audio (alternative TTS)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# ── Optional: Integrations ────────────────────────────────────────────────────

# Notion integration — get token at https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Sentry error tracking — get DSN at https://sentry.io
SENTRY_DSN=

# ── Deployment ────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins (no spaces)
# Example: https://atlas-ai.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=

# App Configuration
APP_NAME=Atlas AI Visual Companion
DEBUG=false
LOG_LEVEL=INFO

# Atlas Mode — controls personality and system prompt
# "desktop" → original assistant (code, screen watching, Notion, productivity)
# "game"    → gaming companion (combat reactions, quest tracking, stays brief)
ATLAS_MODE=desktop

# Database
DATABASE_URL=sqlite+aiosqlite:///./atlas.db

# Server
HOST=0.0.0.0
PORT=8000

# ── Supervisor (Agentic OS) ───────────────────────────────────────────────────
# Voice/chat request → dispatch plan → parallel workers → spoken status.
# See docs/agentic-os-supervisor.md

SUPERVISOR_ENABLED=false
SUPERVISOR_KILL_SWITCH=false
SUPERVISOR_DAILY_BUDGET_CALLS=25     # "expensive" dispatches allowed per UTC day
SUPERVISOR_DEFAULT_TIMEOUT_MS=60000
SUPERVISOR_MAX_TIMEOUT_MS=300000
SUPERVISOR_IDEMPOTENCY_WINDOW_SECS=600
